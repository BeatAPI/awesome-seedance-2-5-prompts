{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BeatAPI/awesome-seedance-2-5-prompts/schema/prompt.schema.json",
  "title": "Seedance 2.5 prompt entry",
  "type": "object",
  "required": [
    "slug",
    "title",
    "description",
    "category",
    "workflowMode",
    "mode",
    "duration",
    "aspectRatio",
    "ingredients",
    "source",
    "outputStatus",
    "promptVisibility",
    "promptSourceUrls",
    "modelEvidenceUrls",
    "prompt",
    "media",
    "rightsStatus"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "required": ["en", "zh"],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "required": ["en", "zh"],
      "additionalProperties": false
    },
    "category": { "type": "string", "minLength": 1 },
    "workflowMode": {
      "enum": [
        "reference-generation",
        "video-editing",
        "video-extension"
      ]
    },
    "mode": {
      "enum": [
        "text-to-video",
        "image-to-video",
        "reference-to-video",
        "multimodal"
      ]
    },
    "duration": { "type": "string", "pattern": "^\\d+s$" },
    "aspectRatio": { "type": "string", "pattern": "^\\d+:\\d+$" },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "source": {
      "type": "object",
      "required": ["kind", "class", "name", "url"],
      "additionalProperties": false
    },
    "outputStatus": {
      "enum": [
        "source-verified",
        "official-example",
        "template-unverified"
      ]
    },
    "promptVisibility": {
      "enum": ["same-post", "same-author-thread"]
    },
    "promptSourceUrls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "modelEvidenceUrls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "prompt": { "type": "string", "minLength": 80 },
    "media": {
      "type": "object",
      "required": [
        "video",
        "thumbnail",
        "format",
        "videoBytes",
        "videoSha256"
      ],
      "additionalProperties": false
    },
    "rightsStatus": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
